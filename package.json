{
  "name": "nextjs-fe-hosting",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cms:login": "optimizely-cms-cli login",
    "cms:push-config": "optimizely-cms-cli config push ./optimizely.config.mjs",
    "cms:push-config-force": "optimizely-cms-cli config push ./optimizely.config.mjs --force",
    "cms:diff": "node scripts/cms-diff.mjs",
    "cms:pull-config": "optimizely-cms-cli config pull --output ./src/content-types --group",
    "deploy-test2": "opticloud ship ./ --type=head --prefix=nextjs-fe-hosting --target=Test2",
    "lh": "node scripts/lighthouse/run.mjs",
    "lh:desktop": "node scripts/lighthouse/run.mjs --desktop",
    "lh:trim": "node scripts/lighthouse/trim.mjs",
    "lh:history": "node scripts/lighthouse/history.mjs",
    "aspire": "docker start aspire-dashboard || docker run -d --name aspire-dashboard --restart unless-stopped -p 18888:18888 -p 4318:18890 -e ASPIRE_DASHBOARD_UNSECURED_ALLOW_ANONYMOUS=true mcr.microsoft.com/dotnet/aspire-dashboard:latest",
    "aspire:stop": "docker stop aspire-dashboard",
    "preinstall": "npx only-allow npm"
  },
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "@azure/monitor-opentelemetry-exporter": "^1.0.0-beta.32",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@optimizely/cms-sdk": "^3.0.2",
    "@redis/entraid": "^5.12.1",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "he": "^1.2.0",
    "lucide-react": "^1.49.0",
    "next": "^16.3.8",
    "next-intl": "^4.14.8",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "redis": "^5.12.1",
    "tailwind-merge": "^3.7.0",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "@kunalshetye/opticloud": "^0.0.6",
    "@optimizely/cms-cli": "^3.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/he": "^1.2.3",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "schema-dts": "^2.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  },
  "packageManager": "npm@11.8.0",
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4",
    "ios_saf >= 16.4",
    "not dead"
  ]
}
