# Optimizely CMS API Credentials
# Get these from your CMS instance: Settings > API Keys > Manage Content
OPTIMIZELY_CMS_CLIENT_ID=
OPTIMIZELY_CMS_CLIENT_SECRET=

# Optimizely Graph Credentials (automatically provided in Frontend Hosting)
# For local development, get these from your CMS instance
OPTIMIZELY_GRAPH_SINGLE_KEY=

# Default setting.
# Note! In the SaaS Frontend, the OPTIMIZELY_GRAPH_GATEWAY variable will be https://cg.optimizely.com
OPTIMIZELY_GRAPH_GATEWAY=https://cg.optimizely.com
OPTIMIZELY_GRAPH_PATH=/content/v2
OPTIMIZELY_CMS_URL=

# NOTE: The Optimizely Web Experimentation snippet is configured ENTIRELY in
# the CMS: SiteSettings → "Web Experimentation snippet ID". Set it to load the
# snippet site-wide, leave it blank to turn it off (a publish clears the whole
# site cache). There is no env-var override — OPTIMIZELY_WEB_EXP_SNIPPET_ID was
# removed so the toggle has a single source of truth and can't be left stuck on
# by a stale server env var.

# Public site origin (no trailing slash). Used for canonical URLs in page
# metadata, /sitemap.xml entries, and /robots.txt's sitemap reference.
# Leave blank during local dev — defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Fallback site name used in JSON-LD and llms.txt when the CMS SiteSettings
# singleton has no value (or before one is created). The CMS value wins when
# both are present.
NEXT_PUBLIC_SITE_NAME=

# Deployment Credentials (optional here)
#
# `npm run deploy-test2` runs the opticloud CLI, which loads this .env file (via
# dotenv) on startup. It resolves credentials in this order: explicit flags, then
# OPTI_* variables in the environment (including ones set here), then the OS
# keychain. So you can either set them here:
#   OPTI_PROJECT_ID=
#   OPTI_CLIENT_KEY=
#   OPTI_CLIENT_SECRET=
#
# or authenticate once (stores in Windows Credential Manager / macOS Keychain):
#   npx opticloud auth:login      # prompts for Client Key, Client Secret, Project ID
#   npx opticloud auth:status     # verify
#
# Get the values from PaaS Portal > API tab > Add API Credentials.
# In CI, export OPTI_PROJECT_ID / OPTI_CLIENT_KEY / OPTI_CLIENT_SECRET from secrets —
# there is no keychain on a build agent.
#
# The target environment comes from the --target flag in the npm script, not an env var.

# ──────────────────────────────────────────────────────────────────────
# All variables below are PROVISIONED BY DXP in Test/Production.
# In local dev, leave blank to skip Redis, webhook registration, and
# CDN purge — the cache handler falls back to an in-memory Map and
# the webhook receiver / registration short-circuit cleanly.
# ──────────────────────────────────────────────────────────────────────

# Redis cache handler (cache-handler.mjs)
REDIS_URL=                           # host:port, e.g. myredis.redis.azure.net:10000
OPTIMIZELY_DXP_DEPLOYMENT_ID=        # used to namespace cache keys
AZURE_CLIENT_ID=                     # managed-identity client ID (Redis + CDN auth)

# CDN purge (Cloud Platform Services edge-cache API)
# §5 of the official ISR doc lists only the variables above as
# platform-set; these two are referenced in the handler code but absent
# from the table. Verify their presence in DXP env before relying on
# CDN purge end-to-end.
OPTIMIZELY_CLOUDPLATFORM_API_URL=
OPTIMIZELY_CLOUDPLATFORM_API_RESOURCE_ID=

# Graph webhook receiver (/hooks/graph) and programmatic registration
OPTIMIZELY_GRAPH_CALLBACK_APIKEY=    # shared secret; sent as x-api-key header
OPTIMIZELY_SITE_HOSTNAME=            # public hostname (e.g. mysite.example.com)
OPTIMIZELY_GRAPH_APP_KEY=            # Basic-auth user for {gateway}/api/webhooks
OPTIMIZELY_GRAPH_SECRET=             # Basic-auth password (from Key Vault)

# ──────────────────────────────────────────────────────────────────────
# OpenTelemetry (src/instrumentation.node.ts). On Frontend Hosting the platform
# sets APPLICATIONINSIGHTS_CONNECTION_STRING and telemetry goes to Application
# Insights; don't set it locally. Leave the OTLP endpoint blank to turn
# telemetry off. Locally, start the Aspire Dashboard with `npm run aspire`
# (Docker) and point this at http://localhost:4318; traces, metrics and logs
# show up at http://localhost:18888.
# ──────────────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=         # e.g. http://localhost:4318
OTEL_SERVICE_NAME=                   # defaults to nextjs-fe-hosting

# ──────────────────────────────────────────────────────────────────────
# Developer tools at /diagnostics (HTTP Basic Auth). If either is unset,
# /diagnostics returns 404. On Frontend Hosting, set them in
# PaaS Portal > App Settings.
# ──────────────────────────────────────────────────────────────────────
DIAGNOSTICS_USER=
DIAGNOSTICS_PASSWORD=
