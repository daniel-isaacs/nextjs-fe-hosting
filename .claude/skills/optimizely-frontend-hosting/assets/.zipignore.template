# Optimizely Frontend Hosting - .zipignore Template
#
# Files and directories EXCLUDED from the deployment package created by
# `opticloud package:create` / `opticloud ship`.
#
# Syntax is identical to .gitignore, including negation (!keep-this.json), but it is
# evaluated separately from git — a file can be gitignored and still packaged, or tracked
# in git and excluded here.
#
# Usage: copy to your Next.js project root as ".zipignore"
#
# NOTE: opticloud already excludes node_modules/, .git/, .env, .env.local and .DS_Store by
# default. That default is a convenience, NOT a security boundary — it does not catch a
# .env.template with real values filled in, certificates/, *.pem, or a stray credential
# dump. List secrets explicitly below and audit the result:
#
#   opticloud package:create ./ --type=head --output=./packages
#   unzip -l ./packages/*.zip | grep -iE '\.env|secret|credential|\.pem|\.key'

# Build outputs (regenerated during deployment)
.next
out

# Dependencies (reinstalled during deployment via package.json)
node_modules

# Environment files (configure these in PaaS Portal > App Settings instead)
.env
.env.local
.env.development
.env.test
.env.production
.env.*.local
.env.template
.env.example

# Secrets and certificates — never ship these
certificates
*.pem
*.key
*.pfx
*.p12

# Version control
.git
.gitignore
.gitattributes

# IDE and editor files
.vscode
.idea
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Agent / dev tooling (not needed at runtime)
.claude
.cursor

# Testing
coverage
.nyc_output
__tests__/__snapshots__

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Temporary files
.tmp
tmp
temp

# OS files
desktop.ini

# Deployment artifacts (don't package previous packages)
*.zip
*.tar.gz
packages

# Documentation
README.md

# Optional: development tooling (uncomment if not needed at build time)
# .eslintrc
# .prettierrc
# jest.config.js
# cypress/

# Optional: CI/CD config (uncomment — usually not needed in the package)
# .github
# .gitlab-ci.yml
# azure-pipelines.yml
# .circleci

# Lock files — DO NOT IGNORE THESE. They must be in the package so the platform
# installs the same dependency versions you built against:
#   package-lock.json   (npm)
#   yarn.lock           (yarn)
#   pnpm-lock.yaml      (pnpm)
